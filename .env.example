# ------------------------------------------------------------------
# Library Management System: environment variable template
#
# 1. Copy this file to ".env" (in the same folder) and fill in YOUR values.
# 2. NEVER commit ".env". NEVER put real secrets in this file.
# 3. The application does NOT connect to MongoDB Atlas yet.
#    These variables are used from Phase 2 onwards.
# 4. Variable names are proposed. config.py will be aligned with them in Phase 2.
# ------------------------------------------------------------------

# --- Flask ---
# 1 = debug mode (development only). Use 0 anywhere else.
FLASK_DEBUG=1

# Long random value used to sign sessions. Generate your own; do not reuse examples.
# Must be different in every environment.
SECRET_KEY=replace-with-a-long-random-value

# --- MongoDB Atlas ---
# Copy the connection string from Atlas (Connect -> Drivers -> Python).
# Replace the placeholders. Use a database user with limited permissions.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_host>/?retryWrites=true&w=majority

# Database used by the running application
MONGODB_DB_NAME=library_management_dev

# Database used by automated tests (must differ from the one above).
# How tests get their database is still an open decision.
MONGODB_TEST_DB_NAME=library_management_test

# --- Sessions and cookies (proposed) ---
# Set to 1 when the site is served over HTTPS (required outside local development).
SESSION_COOKIE_SECURE=0
# How long a login lasts, in minutes
SESSION_LIFETIME_MINUTES=60

# --- CORS (proposed) ---
# Frontend origin(s) allowed to call the API. Comma-separated. No wildcard (*).
# Use 127.0.0.1 consistently for both frontend and backend in development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500