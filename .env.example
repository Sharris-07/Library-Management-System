# Copy to .env in the repository root and replace placeholders.
# Never commit .env or real credentials.
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret

# Copy the complete Python driver URI from MongoDB Atlas.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=LMS
MONGODB_DB_NAME=library_management_dev
MONGODB_TEST_DB_NAME=library_management_test
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Local development only. Set secure=1 when served over HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=60

# Vite defaults to port 5173. Add other exact origins only when required.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
